extends SceneTree

var failures := 0

func check(condition: bool, description: String) -> void:
	if not condition:
		failures += 1
		printerr("FAIL: " + description)
	else:
		print("PASS: " + description)

func _initialize() -> void:
	call_deferred("run_checks")

func settle() -> void:
	await physics_frame
	await physics_frame

func run_checks() -> void:
	var game = load("res://levels/entry.tscn").instantiate()
	root.add_child(game)
	await settle()
	check(game.environment != null and game.environment.has_method("set_story_sources"), "real entry environment API loaded")
	check(game.player.has_real_model and game.player.animation_names.size() == 4, "M1 uses real four animation character")
	check(not game.creature.caption.visible, "distant creature label stays hidden before encounter")
	check(game.audio_listener.is_current() and game.audio_listener.global_position.distance_to(game.player.global_position) < 0.8, "spatial audio listens beside player instead of distant orthographic camera")
	game.player.position = Vector3(0, 0.05, -13)
	game.interact()
	check(game.progress.outcome == "playing" and game.hud.message_label.text.contains("还没有"), "empty-handed exit explains missing box")
	game.player.position = Vector3(-5.5, 0.05, 1.6)
	game.interact()
	check(not game.progress.item_collected, "item cannot skip harmless discovery")
	game.player.position = game.chicken.position + Vector3(0, 0.05, 0.9)
	await settle()
	check(game.progress.chicken_discovered and game.progress.stage == 1, "approaching moving chicken reveals harmless clue")
	check(not game.creature.caption.visible, "chicken discovery does not spoil distant creature")
	var chicken_before: Vector3 = game.chicken.position
	game.player.facing = (game.chicken.position - game.player.position).normalized()
	game.player.attack.begin(false)
	game.player.attack.tick(0.60, false)
	game.player.check_hits()
	check(game.chicken.discovered and game.chicken.visible and game.progress.pickup_count == 0, "branch cannot hurt chicken or farm rewards")
	game.player.attack.reset()
	game.player.position = Vector3(-5.5, 0.05, 1.7)
	game.interact()
	game.interact()
	check(game.progress.item_collected and game.progress.pickup_count == 1 and not game.item.visible, "E collection consumes box exactly once")
	game.player.position = Vector3(5.0, 0.05, -5)
	await settle()
	check(game.progress.enemy_seen and game.creature.hit_count == 0, "northern bypass observes danger without striking creature")
	check(game.creature.caption.visible, "observed creature gains an identifying danger label")
	game.player.position = Vector3(0, 0.05, -13)
	game.interact()
	check(game.progress.outcome == "won" and paused, "non-combat route completes with box and freezes danger")
	check(not game.hud.message_label.visible and game.hud.damage_time == 0.0, "completion clears stale gameplay prompts")
	var stopped_time: float = game.progress.elapsed
	game.on_enemy_strike()
	game.progress.tick(5.0, false)
	check(game.progress.health == 3 and game.progress.elapsed == stopped_time, "won run cannot take damage or accumulate time")
	game.reset_run()
	check(not paused and game.progress.stage == 0 and game.progress.health == 3 and not game.progress.item_collected and game.item.visible, "victory retry resets quest health and item")
	check(game.creature.active and game.creature.health == 2 and game.creature.hit_count == 0, "victory retry restores creature")
	check(game.player.position.distance_to(Vector3(0, 0.05, 12)) < 0.01 and game.player.attack.remaining == 0, "victory retry restores entry spawn and attack")
	game.creature.set_physics_process(false)
	game.creature.position = Vector3(-1.8, 0.05, -6)
	game.player.position = Vector3(-1.8, 0.05, -4.95)
	game.player.facing = Vector3(0, 0, -1)
	game.player.attack.begin(false)
	game.player.attack.tick(0.60, false)
	game.player.check_hits()
	game.player.check_hits()
	check(game.creature.hit_count == 1 and game.creature.health == 1 and game.creature.mode == "stunned", "one swing hits and stuns creature only once")
	game.set_paused(true)
	game.creature.receive_hit(Vector3.FORWARD)
	check(game.creature.hit_count == 1, "paused creature cannot receive damage")
	game.set_paused(false)
	game.player.attack.reset()
	game.player.attack.begin(false)
	game.player.attack.tick(0.60, false)
	game.player.check_hits()
	check(game.creature.hit_count == 2 and not game.creature.active and game.progress.enemy_repelled, "second separate swing drives creature away without requiring a kill")
	game.player.attack.reset()
	game.player.attack.begin(false)
	game.player.attack.tick(0.60, false)
	game.player.check_hits()
	check(game.creature.hit_count == 2, "driven-away creature cannot be farmed for repeated hits")
	game.reset_run()
	check(game.creature.mode == "patrol" and game.creature.state_time == 0 and game.creature.velocity == Vector3.ZERO and game.creature.figure.visible, "retry clears stun knockback and enemy visuals")
	game.creature.set_physics_process(false)
	game.player.position = game.creature.position + Vector3(0, 0, 0.8)
	game.on_enemy_strike()
	game.on_enemy_strike()
	check(game.progress.health == 2, "consecutive contact events remove only one heart")
	game.progress.tick(1.3, false)
	game.on_enemy_strike()
	game.progress.tick(1.3, false)
	game.on_enemy_strike()
	check(game.progress.outcome == "lost" and game.progress.health == 0 and paused, "three separated hits show failure and stop danger")
	check(not game.hud.message_label.visible and game.hud.damage_time == 0.0, "failure clears transient hit feedback behind result")
	game.reset_run()
	check(game.progress.outcome == "playing" and game.progress.health == 3 and game.progress.elapsed == 0 and not paused and not game.chicken.discovered, "failure retry resets complete run")
	game.creature.set_physics_process(true)
	print("Entry playable: %d failures" % failures)
	game.queue_free()
	await process_frame
	quit(1 if failures else 0)
